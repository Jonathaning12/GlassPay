NODE_ENV=development
PORT=3000
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_RETURN_URL=http://localhost:3000/paypal/return
PAYPAL_CANCEL_URL=http://localhost:3000/paypal/cancel
PAYMENT_MAX_AMOUNT=1000
PAYMENT_DEFAULT_CURRENCY=MXN
PAYMENT_ALLOWED_CURRENCIES=MXN
DATABASE_PATH=.data/glasspay.db
QR_TOKEN_TTL_SECONDS=180
QR_RESOLUTION_TTL_SECONDS=300
PAYMENT_REQUEST_TTL_SECONDS=600
PAYMENT_STATUS_TOKEN_FINAL_MARGIN_SECONDS=300
MAX_PENDING_REQUESTS=5
PAYER_WEB_ORIGIN=http://localhost:5173
AI_PROVIDER=
AI_MODEL=
GEMINI_API_KEY=
AI_TIMEOUT_MS=5000
# Tope diario compartido por el cobro por voz y el chat del asistente.
AI_DAILY_CALL_LIMIT=100
CHARGE_PROPOSAL_TTL_SECONDS=120# Cobros programados desde el chat (C2a). Valores no sensibles; todos opcionales.
# Vigencia del cobro creado a la hora (máx. 21600 = 6 h, el límite por defecto de PayPal para mandar a aprobar).
SCHEDULED_CHARGE_TTL_SECONDS=18000
SCHEDULED_MAX_ACTIVE=10
SCHEDULED_MAX_HORIZON_DAYS=30
SCHEDULED_LATE_TOLERANCE_SECONDS=7200
ASSISTANT_PROPOSAL_TTL_SECONDS=120
SCHEDULER_INTERVAL_MS=60000
# Recordatorios de pago (C2c): máximo por contacto al día (hora de México).
REMINDERS_MAX_PER_DAY=2
# Pagos programados (C3): máximo de pagos automáticos ("bajo tu riesgo") activos por cobrador.
SCHEDULED_MAX_AUTO_PAYMENTS=3
